# Browser-safe values
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
COOKIE_SECRET=replace-with-at-least-32-random-characters
INTERNAL_JOB_SECRET=replace-with-a-separate-rotating-secret
DEMO_MODE=true

# Supabase (never prefix service secrets with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Initial administrator (used by supabase/seed/bootstrap-admin.ts)
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_PASSWORD=replace-before-running
