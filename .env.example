# Browser-safe values
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
COOKIE_SECRET=replace-with-at-least-32-random-characters
INTERNAL_JOB_SECRET=replace-with-a-separate-rotating-secret
DEMO_MODE=true

# MongoDB (never expose these to the browser). A replica set is required
# because candidate import and cycle purge use multi-document transactions;
# even a single-node replica set is sufficient (see docker-compose.yml).
MONGODB_URI=mongodb://localhost:27017/pathey?replicaSet=rs0
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
CANDIDATE_PHOTO_DIR=./storage/candidate-photos

# Initial administrator (used by mongo/seed.mjs)
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ADMIN_PASSWORD=replace-before-running
